# Local PostgreSQL connection (Docker Compose maps host port 5434)
DATABASE_URL=postgresql://gym_admin:replace_this_password@localhost:5434/gym_management?schema=public

# Replace with long random secrets before any shared/production deployment
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Optional mail delivery configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gym Management
SMTP_SECURE=false

# Optional trainer image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


POSTGRES_USER=replace_with_local_value
POSTGRES_PASSWORD=replace_with_local_value
POSTGRES_DB=replace_with_local_value
